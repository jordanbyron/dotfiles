[user]
  name = Jordan Byron
  email = jordan@jordanbyron.com
  signingkey = ~/.ssh/id_ed25519.pub
[core]
  excludesfile = ~/.gitignore
  editor = nvim
  autocrlf = input
  safecrlf = true
[color]
  status = auto
  branch = auto
  interactive = auto
  diff = auto
[rerere]
  enabled = 1
[push]
  default = simple
  autoSetupRemote = true
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
[credential]
  helper = osxkeychain
[credential "https://github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
[commit]
  gpgsign = true
[tag]
  gpgsign = true
