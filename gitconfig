[user]
  name = Jordan Byron
  email = jordan@jordanbyron.com
[core]
  excludesfile = /Users/byron/.gitignore
  editor = nvim
  autocrlf = input
  safecrlf = true
[color]
  status = auto
  branch = auto
  interactive = auto
  repositoryformatversion = 0
  filemode = true
  bare = false
  logallrefupdates = true
  diff = auto
[rerere]
  enabled = 1
[push]
  default = matching
[credential]
  helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
